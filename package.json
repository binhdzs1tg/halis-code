{
  "name": "@halis/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Halis Code — coding agent for the desktop and the terminal",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w halis-code && npm run build -w @halis/desktop",
    "dev:desktop": "npm run dev -w @halis/desktop",
    "dev:cli": "npm run dev -w halis-code",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "cli": "node packages/cli/bin/halis.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.9.0": true,
    "electron-winstaller@5.4.0": true
  }
}

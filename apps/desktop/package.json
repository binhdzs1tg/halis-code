{
  "name": "@halis/desktop",
  "version": "0.1.0",
  "description": "Halis Code - desktop coding agent",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/binhdzs1tg/halis-code",
  "desktopName": "halis-code.desktop",
  "private": true,
  "license": "MIT",
  "author": "binhdzs1tg",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "watch": "node scripts/build.mjs --watch",
    "sync-models": "node scripts/sync-models.mjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --outfile=dist/smoke.cjs --log-level=error && node dist/smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  }
}
